{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranslationOutput",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "TranslatedUnit",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "segment_id",
          "target_text"
        ]
      }
    }
  },
  "required": [
    "translations"
  ]
}
