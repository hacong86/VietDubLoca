    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message_vi": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
