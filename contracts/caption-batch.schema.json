{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptionBatch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timeline_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_kind": {
      "enum": [
        "manual",
        "auto",
        "import",
        "asr"
      ]
    },
    "language": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "coverage": {
      "enum": [
        "full",
        "partial",
        "current_only"
      ]
    },
    "available_until_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cues": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SourceCue",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 16000
          },
          "committed": {
            "type": "boolean"
          }
        },
        "required": [
          "cue_id",
          "start_ms",
          "end_ms",
          "text",
          "committed"
        ]
      }
    }
  },
  "required": [
    "session_id",
    "timeline_epoch",
    "source_id",
    "source_revision",
    "source_kind",
    "language",
    "coverage",
    "available_until_ms",
    "cues"
  ]
}
